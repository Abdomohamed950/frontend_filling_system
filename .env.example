# Backend REST API. The history/reports/ports/operators endpoints live here.
# Leave blank to derive it from the browser host on the port below (same
# pattern as the socket URL) — this is what lets a phone on the same
# network reach the panel without editing anything per device.
VITE_API_URL=
VITE_API_PORT=3000

# Realtime gateway (socket.io) that streams port telemetry.
# Leave blank to derive it from the browser host on the port below.
VITE_SOCKET_URL=
VITE_SOCKET_PORT=5000

# Demo accounts have no row in `operator`, so they get no integer id and the
# operator console refuses to start a fill. Set this to a real operator(id)
# when bench-testing the gateway without the auth service.
VITE_OFFLINE_OPERATOR_ID=
